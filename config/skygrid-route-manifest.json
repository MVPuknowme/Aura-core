{
  "schema_version": "1.0.0",
  "source_of_truth": "github",
  "service": "SKYGRID Emergency Data On-Ramp",
  "mode": "controlled_pilot",
  "sentinel": "fail_closed",
  "policy": {
    "device_activation": false,
    "production_failover": false,
    "private_data_movement": false,
    "wallet_signing": false,
    "transaction_broadcast": false
  },
  "runtimes": {
    "vercel": {
      "owner": "api/runtime.mjs",
      "role": "public runtime, dashboard, advisory route decisioning"
    },
    "cloudflare_worker": {
      "owner": "src/worker.js",
      "role": "edge health, status, intake acknowledgement"
    },
    "postman": {
      "owner": "postman/skygrid-autodrill.collection.json",
      "role": "route proof, auto-drill checks, contract validation"
    },
    "aws": {
      "owner": "environment variables and protected AWS runtime",
      "role": "future persistence, validation, and production failover backbone"
    }
  },
  "routes": [
