{
  "schema_version": "1.0.0",
  "source_of_truth": "github",
  "service": "SKYGRID Emergency Data On-Ramp",
  "mode": "controlled_pilot",
  "sentinel": "fail_closed",
  "policy": {
    "payment_execution_provider": "github_sponsors",
    "device_activation": false,
    "production_failover": false,
    "private_data_movement": false,
    "wallet_signing": false,
    "transaction_broadcast": false
  },
  "runtimes": {
    "vercel": {
      "owner": "api/runtime.mjs",
      "role": "public runtime, dashboard, advisory route decisioning"
    },
    "cloudflare_worker": {
      "owner": "src/worker.js",
      "role": "edge health, status, intake acknowledgement, sponsor link"
    },
    "postman": {
      "owner": "postman/skygrid-autodrill.collection.json",
      "role": "route proof, auto-drill checks, contract validation"
    },
    "aws": {
      "owner": "environment variables and protected AWS runtime",
      "role": "future persistence, validation, and production failover backbone"
    }
  },
  "routes": [
    { "id": "home", "method": "GET", "path": "/", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "health_json", "method": "GET", "path": "/health.json", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "dispatch", "method": "GET", "path": "/dispatch", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "incidents", "method": "GET", "path": "/incidents", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "settings", "method": "GET", "path": "/settings", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "highway", "method": "GET", "path": "/highway", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "scenarios", "method": "GET", "path": "/scenarios", "owner": "vercel", "proof_owner": "postman", "required": false, "status": "implemented" },
    { "id": "rates", "method": "GET", "path": "/rates", "owner": "vercel", "proof_owner": "postman", "required": false, "status": "implemented" },
    { "id": "base", "method": "GET", "path": "/base", "owner": "vercel", "proof_owner": "postman", "required": false, "status": "implemented" },
    { "id": "pay", "method": "GET", "path": "/pay", "owner": "vercel", "proof_owner": "postman", "required": false, "status": "implemented" },
    { "id": "skygrid_status", "method": "GET", "path": "/api/skygrid/status", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "skygrid_intake", "method": "POST", "path": "/api/skygrid/intake", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "aura_core_decide", "method": "POST", "path": "/api/aura-core/decide", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "agent_signals", "method": "POST", "path": "/api/agent/signals", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "highway_status", "method": "GET", "path": "/api/highway/status", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "highway_flasks", "method": "GET", "path": "/api/highway/flasks", "owner": "vercel", "proof_owner": "postman", "required": false, "status": "implemented" },
    { "id": "highway_postman", "method": "GET", "path": "/api/highway/postman", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "pay_quote", "method": "GET", "path": "/api/pay/quote", "sample_path": "/api/pay/quote?amount=25", "owner": "vercel", "proof_owner": "postman", "required": true, "status": "implemented" },
    { "id": "sponsors_link", "method": "GET", "path": "/api/sponsors/link", "owner": "vercel_and_cloudflare", "proof_owner": "postman", "required": true, "status": "implemented_in_file_route_and_worker" },
    { "id": "stripe_device_link_legacy", "method": "GET", "path": "/api/stripe/device-link", "owner": "vercel_and_cloudflare", "proof_owner": "postman", "required": false, "status": "legacy_compatibility" },
    { "id": "autodrill_latest", "method": "GET", "path": "/api/autodrill/latest", "owner": "postman_then_runtime", "proof_owner": "postman", "required": true, "status": "planned" },
    { "id": "build_pad_quote", "method": "POST", "path": "/api/build-pad/quote", "owner": "postman_then_runtime", "proof_owner": "postman", "required": true, "status": "planned" },
    { "id": "node_lease_intake", "method": "POST", "path": "/api/node-lease/intake", "owner": "postman_then_runtime", "proof_owner": "postman", "required": true, "status": "planned" },
    { "id": "failover_status", "method": "GET", "path": "/api/failover/status", "owner": "postman_then_runtime", "proof_owner": "postman", "required": true, "status": "planned_blocked_until_readiness" }
  ],
  "launch_ladder": [
    "auto_drill_proof",
    "build_pad_quote",
    "node_lease_intake",
    "dashboard",
    "aws_persistence",
    "partner_pilot",
    "manual_failover",
    "limited_production_failover",
    "full_automated_failover"
  ]
}
