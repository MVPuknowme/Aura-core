{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm exec --yes --package=pnpm@10.23.0 -- pnpm install --frozen-lockfile",
  "buildCommand": "node -e \"console.log('SKYGRID Emergency Data On-Ramp API deployment: no frontend build required')\"",
  "outputDirectory": null,
  "redirects": [
    { "source": "/articles/skygrid-dispatcher-public-demo.md", "destination": "/articles/skygrid-dispatcher-public-demo", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/runtime" },
    { "source": "/health.json", "destination": "/api/runtime" },
    { "source": "/dispatch", "destination": "/api/runtime" },
    { "source": "/incidents", "destination": "/api/runtime" },
    { "source": "/settings", "destination": "/api/runtime" },
    { "source": "/highway", "destination": "/api/runtime" },
    { "source": "/scenarios", "destination": "/api/runtime" },
    { "source": "/rates", "destination": "/api/runtime" },
    { "source": "/base", "destination": "/api/runtime" },
    { "source": "/pay", "destination": "/api/runtime" },
    { "source": "/articles/skygrid-dispatcher-public-demo", "destination": "/api/skygrid-dispatcher-public-demo" },
    { "source": "/dashboard/command-center", "destination": "/api/runtime" },
    { "source": "/dashboard/validation-panel", "destination": "/api/runtime" },
    { "source": "/dashboard/deployment-review", "destination": "/api/runtime" },
    { "source": "/dashboard/receipts", "destination": "/api/runtime" },
    { "source": "/api/skygrid/status", "destination": "/api/runtime" },
    { "source": "/api/skygrid/intake", "destination": "/api/runtime" },
    { "source": "/api/aura-core/decide", "destination": "/api/runtime" },
    { "source": "/api/agent/signals", "destination": "/api/runtime" },
    { "source": "/api/highway/status", "destination": "/api/runtime" },
    { "source": "/api/highway/flasks", "destination": "/api/runtime" },
    { "source": "/api/highway/postman", "destination": "/api/runtime" },
    { "source": "/api/pay/quote", "destination": "/api/runtime" },
    { "source": "/api/autodrill/latest", "destination": "/api/runtime" },
    { "source": "/api/build-pad/quote", "destination": "/api/runtime" },
    { "source": "/api/node-lease/intake", "destination": "/api/runtime" },
    { "source": "/api/failover/status", "destination": "/api/runtime" },
    { "source": "/api/panels/summary", "destination": "/api/runtime" }
  ]
}
