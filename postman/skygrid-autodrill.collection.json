    {
      "name": "Aura-Core Decide Proof",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/aura-core/decide",
        "body": {
          "mode": "raw",
          "raw": "{\"source\":\"postman-autodrill\",\"mode\":\"controlled_pilot\",\"route\":\"decision-proof\",\"noProductionFailover\":true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('route proof status is allowed', () => pm.expect([200,202,400,422,502]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Agent Signals Proof",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/agent/signals",
        "body": {
          "mode": "raw",
          "raw": "{\"source\":\"postman-autodrill\",\"signal\":\"route-proof\",\"severity\":\"test\"}"
        }
      },
      "event": [
        {
