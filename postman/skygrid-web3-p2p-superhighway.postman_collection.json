{
  "info": {
    "name": "SkyGrid Web3 ⇄ P2P API Superhighway Mock",
    "description": "Mock-first Postman collection for Aura-Core / SkyGrid API superhighway connecting Web3, L2/mainnet bridge status, P2P node heartbeats, failover signals, proof logs, and utility-billing riders. Designed to be imported into Postman, used with a Postman mock server, and later pointed at real staging endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('iso_now', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('global: response is not 5xx', function () { pm.expect(pm.response.code).to.be.below(500); });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://{{mock_url}}",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "postman-local-placeholder",
      "type": "string"
    },
    {
      "key": "mock_url",
      "value": "replace-with-created-mock-host.mock.pstmn.io",
      "type": "string"
    },
    {
      "key": "intent_id",
      "value": "bridge_intent_001",
      "type": "string"
    },
    {
      "key": "proof_id",
      "value": "proof_bridge_status_001",
      "type": "string"
    },
    {
      "key": "test_customer_ref",
      "value": "customer-demo-001",
      "type": "string"
    },
    {
      "key": "test_node_id",
      "value": "node-demo-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health and Discovery",
      "item": [
        {
          "name": "GET API Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('response time under 3000ms', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "const json = pm.response.json();",
                  "pm.test('response has status/accepted/proofId signal', function () {",
                  "  pm.expect(json.accepted !== undefined || json.status !== undefined || json.proofId !== undefined || json.available !== undefined).to.eql(true);",
                  "});",
                  "if (json.proofId) { pm.environment.set('proof_id', json.proofId); }"
                ]
              }
            }
          ],
