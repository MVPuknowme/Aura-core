{
  "info": {
    "name": "Patrick/Newman Postman Kafka Bridge TM Reliability Checks",
    "description": "Postman/Newman checks for the Patrick/Newman Postman Kafka Bridge TM: a temporary emergency-notice link that verifies delivery across Web3-facing references, Vercel, B12, and the AWS emergency ramp without activating funds, devices, or production routing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patrick/Newman Postman Kafka Bridge TM Link Map",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const linkMap = {",
              "  bridge_name: 'Patrick/Newman Postman Kafka Bridge TM',",
              "  bridge_mode: 'temporary_emergency_notice_link',",
              "  web3_gateway_url: pm.collectionVariables.get('web3_gateway_url'),",
              "  site_url: pm.collectionVariables.get('site_url'),",
              "  b12_site_url: pm.collectionVariables.get('b12_site_url'),",
              "  base_url: pm.collectionVariables.get('base_url'),",
              "  aws_service_url: pm.collectionVariables.get('aws_service_url')",
              "};",
              "pm.test('Patrick/Newman Postman Kafka Bridge TM has required public URLs', function () {",
              "  pm.expect(linkMap.site_url).to.match(/^https?:\\/\\//);",
              "  pm.expect(linkMap.base_url).to.match(/^https?:\\/\\//);",
              "  pm.expect(linkMap.b12_site_url).to.match(/^https?:\\/\\//);",
              "  pm.expect(linkMap.aws_service_url).to.match(/^https?:\\/\\//);",
              "});",
              "pm.collectionVariables.set('patrick_newman_postman_kafka_bridge_link_map', JSON.stringify(linkMap));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/intake",
          "host": ["{{base_url}}"],
          "path": ["api", "intake"]
        }
      }
    },
    {
      "name": "Web3 Gateway Reference",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{web3_gateway_url}}",
          "host": ["{{web3_gateway_url}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Web3 gateway reference is reachable or intentionally protected', function () {",
              "  pm.expect([200, 204, 301, 302, 400, 401, 403, 404, 405, 503]).to.include(pm.response.code);",
              "});",
              "pm.test('Web3 gateway response time is under 7000ms', function () {",
              "  pm.expect(pm.response.responseTime).to.be.below(7000);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "site_url", "value": "https://aura-core.vercel.app/" },
    { "key": "base_url", "value": "https://aura-core.vercel.app" },
    { "key": "b12_site_url", "value": "https://aura-sky-skygrid-protocol-staging.b12sites.com" },
    { "key": "web3_gateway_url", "value": "https://aura-core.vercel.app/api/intake" },
    { "key": "aws_service_url", "value": "https://aura-core.vercel.app" }
  ]
}
