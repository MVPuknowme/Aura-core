FROM node:24-bookworm-slim

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

COPY config/aerodrome-base-rpc.mjs config/skygrid-operator.mjs config/skygrid-wallet-lanes.mjs ./config/
COPY api/runtime.mjs api/runtime-core.mjs ./api/
COPY api/aerodrome/wallet.mjs ./api/aerodrome/
COPY api/wallet/dual-lane.mjs ./api/wallet/
COPY bridge/skygrid-emergency-onramp.pnpk ./bridge/
COPY cloudflare/skygrid-edge-worker/src/capacity-lease.js cloudflare/skygrid-edge-worker/src/lease-page.js ./cloudflare/skygrid-edge-worker/src/
COPY scripts/skygrid-ci-auth-bootstrap.mjs scripts/skygrid-local-runtime-router.mjs scripts/skygrid-local-runtime-server.mjs scripts/skygrid-operator-runner.mjs scripts/skygrid-operator-startup-check.mjs ./scripts/

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    SKYGRID_OPERATOR=MVPuknowme \
    SKYGRID_RUNTIME_MODE=local-container

EXPOSE 3000

RUN pnpm run operator:startup-check

CMD ["pnpm", "run", "operator:container"]
