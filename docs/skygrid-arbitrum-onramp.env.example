# SKYGRID Emergency Data On-Ramp — Arbitrum environment template
# Safe to commit: placeholders only. Put real values in Vercel/AWS/Cloudflare secrets, not in Git.

# Operating posture
SKYGRID_SERVICE="SKYGRID Emergency Data On-Ramp"
SKYGRID_MODE=controlled_pilot
SKYGRID_SENTINEL=fail_closed
SKYGRID_WEB3_EXECUTION_MODE=quote_only_no_wallet_signing
SKYGRID_WALLET_SIGNING_ALLOWED=false
SKYGRID_TRANSACTION_BROADCAST_ALLOWED=false
SKYGRID_PAYMENT_EXECUTION_ALLOWED=false

# Existing ramp verification
SKYGRID_BASE_URL=https://skygrid-protocol.net
PNPK_PATH=bridge/skygrid-emergency-onramp.pnpk

# Arbitrum public RPC routing
# Use ARBITRUM_CHAIN_ID=421614 for Sepolia testnet first.
# Use ARBITRUM_CHAIN_ID=42161 for Arbitrum One mainnet only after guardrails pass.
ARBITRUM_ENABLED=true
ARBITRUM_NETWORK=sepolia
ARBITRUM_CHAIN_ID=421614
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEQUENCER_FEED_URL=wss://sepolia-rollup.arbitrum.io/feed
ARBITRUM_SEQUENCER_ENDPOINT=https://sepolia-rollup-sequencer.arbitrum.io/rpc
ARBITRUM_BLOCK_EXPLORER=https://sepolia.arbiscan.io

# Parent chain requirements if running your own Nitro node
# Required by Nitro for Arbitrum One/Nova/Sepolia node operation.
# Do not expose these directly to browsers or public unauthenticated clients.
ETHEREUM_PARENT_RPC_URL=
ETHEREUM_BEACON_RPC_URL=
NITRO_DOCKER_IMAGE=offchainlabs/nitro-node:v3.9.9-6b0af88
NITRO_DATA_DIR=/data/arbitrum
NITRO_HTTP_PORT=8547
NITRO_WS_PORT=8548
NITRO_SEQUENCER_FEED_PORT=9642
NITRO_INIT_MODE=pruned
NITRO_GOMEMLIMIT=48GiB
NITRO_MEM_FREE_LIMIT=4GiB
NITRO_PUBLIC_RPC_EXPOSED=false

# SKYGRID route behavior
SKYGRID_ARBITRUM_ROLE=provisional_settlement_quote_runtime
SKYGRID_ARBITRUM_ROUTE=/api/arbitrum/status
SKYGRID_ARBITRUM_QUOTE_ROUTE=/api/arbitrum/quote
SKYGRID_ARBITRUM_PROOF_ROUTE=/api/arbitrum/proof
SKYGRID_ARBITRUM_GUARDRAIL=advisory_only_no_signing_no_broadcast
