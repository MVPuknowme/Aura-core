# Local server
PORT=8787
PUBLIC_BASE_URL=https://replace-with-https-host.example

# Apple Wallet / PassKit certificate lane. Do not use ALD certificates here.
PASS_TYPE_IDENTIFIER=pass.net.skygrid.veteranstatus
TEAM_IDENTIFIER=YOUR_APPLE_TEAM_ID
ORGANIZATION_NAME=SKYGRID Veteran Wallet Pilot

# Put real certificate material under ./certs locally only. Do not commit certs.
PASS_CERT_PATH=./certs/pass.pem
PASS_KEY_PATH=./certs/pass.key
WWDR_CERT_PATH=./certs/wwdr.pem
PASS_KEY_PASSPHRASE=

# Presentation/demo values only. Production must source these from an authenticated eligibility flow.
DEMO_DISPLAY_NAME=Demo Veteran
DEMO_SERVICE_SUMMARY=United States Uniformed Services
