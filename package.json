{
  "name": "aura-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "pnpk:validate": "node scripts/validate-pnpk.mjs",
    "manifest:sync": "node scripts/verify-skygrid-manifest-sync.mjs",
    "ramp:switch": "node scripts/aura-core-ai-ramp-switch.mjs",
    "partition:verify": "node scripts/skygrid-partition-router.mjs",
    "autodrill:sim": "node scripts/skygrid-autodrill-sim.mjs",
    "training:drill": "node scripts/skygrid-training-drill.mjs",
    "training:fail-closed": "node scripts/skygrid-fail-closed-drill.mjs",
    "training:verify-receipts": "node scripts/verify-skygrid-training-receipts.mjs",
    "training:all": "pnpm run training:drill && pnpm run training:fail-closed",
    "skygrid:training": "node scripts/skygrid-training-drill.mjs",
    "security:test": "node --check api/runtime-hardened.mjs && node scripts/test-runtime-security.mjs",
    "intake:policy-test": "node --test tests/skygrid-intake-policy.test.mjs",
    "build": "pnpm run pnpk:validate && pnpm run manifest:sync && pnpm run security:test && pnpm run intake:policy-test && node scripts/vercel-build.mjs",
    "build:xmcp": "node tools/xmcp/index.mjs build --vercel",
    "xmcp:build": "node tools/xmcp/index.mjs build --vercel",
    "skygrid:verify": "node scripts/verify-skygrid-routes.mjs",
    "skygrid:test:routing": "node scripts/test-skygrid-routing-success.mjs",
    "aura:selection:watch": "node scripts/aura-core-ai-selection-watch.mjs",
    "mcp:check": "node scripts/check-mcp-sdk.mjs",
    "emergency:gate": "node scripts/skygrid-emergency-gate.mjs",
    "local:worker:start": "node scripts/skygrid-local-worker-start.mjs --approve-owner-test",
    "eth:collection:draft": "node scripts/skygrid-ethereum-collection-draft.mjs",
    "local:ethereum:proof": "pnpm run local:worker:start && pnpm run eth:collection:draft",
    "local:worker:proof": "node scripts/skygrid-local-worker-start.mjs",
    "local:worker:fallback": "node scripts/skygrid-local-worker-start.mjs --approve-owner-test --fallback",
    "local:owner:selftest": "node scripts/skygrid-owner-self-test-execute.mjs",
    "smoke:ai-gateway": "node --env-file=.env.local ./scripts/ai-gateway-smoke.mjs",
    "local:runtime": "node scripts/skygrid-local-runtime-server.mjs",
    "agentkit:basepay:smoke": "node --env-file=.env.local scripts/agentkit-basepay-smoke.mjs",
    "route:probe": "node scripts/skygrid-route-option-probe.mjs",
    "route:probe:primary": "node scripts/skygrid-route-option-probe.mjs --scenario=primary",
    "route:probe:local": "node scripts/skygrid-route-option-probe.mjs --scenario=local",
    "route:probe:queue": "node scripts/skygrid-route-option-probe.mjs --scenario=queue",
    "route:probe:proof": "pnpm run route:probe:primary && pnpm run route:probe:local && pnpm run route:probe:queue",
    "security:ioc-check": "node scripts/check-iocs.mjs",
    "skygrid:verify:public": "node scripts/verify-skygrid-public.mjs"
  },
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vercel/sandbox": "^2.2.1",
    "ai": "^6.0.208",
    "express": "^5.2.1",
    "openai": "^6.47.0",
    "xmcp": "^0.6.13",
    "zod": "^3.25.76"
  },
  "bin": {
    "ng": "tools/ng/index.mjs",
    "xmcp": "tools/xmcp/index.mjs"
  }
}
