{
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.23.0",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "operator:status": "node scripts/skygrid-operator-runner.mjs status",
        "operator:local": "node scripts/skygrid-operator-runner.mjs local",
        "operator:container": "node scripts/skygrid-operator-startup-check.mjs && node scripts/skygrid-operator-runner.mjs local-container",
        "operator:vercel-build": "node scripts/skygrid-operator-preflight.mjs && node scripts/skygrid-operator-runner.mjs vercel-build",
        "operator:test": "node --test tests/skygrid-operator-mode.test.mjs",
        "operator:artifact-test": "node --test tests/skygrid-operator-artifact.test.mjs",
        "operator:startup-check": "node scripts/skygrid-operator-startup-check.mjs",
        "operator:preflight": "node scripts/skygrid-operator-preflight.mjs",
        "pnpk:validate": "node scripts/validate-pnpk.mjs",
        "pnpk:postbuild": "node scripts/run-pnpk-postbuild.mjs",
        "pnpk:postbuild-test": "node --test tests/pnpk-postbuild.test.mjs",
        "pnpk:verify": "node --test tests/pnpk-postbuild.test.mjs && node scripts/run-pnpk-postbuild.mjs",
        "manifest:sync": "node scripts/verify-skygrid-manifest-sync.mjs",
        "ramp:switch": "node scripts/aura-core-ai-ramp-switch.mjs",
        "partition:verify": "node scripts/skygrid-partition-router.mjs",
        "autodrill:sim": "node scripts/skygrid-autodrill-sim.mjs",
        "training:drill": "node --import ./scripts/skygrid-training-signed-fetch.mjs scripts/skygrid-training-drill.mjs",
        "training:fail-closed": "node --import ./scripts/skygrid-training-signed-fetch.mjs scripts/skygrid-fail-closed-drill.mjs",
        "training:verify-receipts": "node scripts/verify-skygrid-training-receipts.mjs",
        "training:all": "pnpm run training:drill && pnpm run training:fail-closed",
        "skygrid:training": "node --import ./scripts/skygrid-training-signed-fetch.mjs scripts/skygrid-training-drill.mjs",
        "build": "node --test tests/skygrid-operator-mode.test.mjs tests/skygrid-operator-artifact.test.mjs tests/skygrid-opensea-preflight.test.mjs && node scripts/test-runtime-security.mjs && node scripts/test-aerodrome-wallet-rpc.mjs && node scripts/test-dual-lane-wallet-rpc.mjs && node scripts/test-local-wallet-routing.mjs && node scripts/skygrid-build.mjs",
        "postbuild": "node scripts/run-pnpk-postbuild.mjs",
        "build:xmcp": "node tools/xmcp/index.mjs build --vercel",
        "xmcp:build": "node tools/xmcp/index.mjs build --vercel",
        "npm:env:check": "node scripts/check-npm-env-config.mjs",
        "npm:env:test": "node --test tests/npm-env-config.test.mjs",
        "aerodrome:rpc:test": "node --check api/aerodrome/wallet.mjs && node scripts/test-aerodrome-wallet-rpc.mjs",
        "wallet:dual-lane:test": "node --check api/wallet/dual-lane.mjs && node --check config/skygrid-wallet-lanes.mjs && node scripts/test-dual-lane-wallet-rpc.mjs",
        "wallet:routing:test": "node --check scripts/skygrid-local-runtime-router.mjs && node scripts/test-local-wallet-routing.mjs",
        "security:test": "node --test tests/skygrid-operator-mode.test.mjs && node scripts/test-runtime-security.mjs && node scripts/test-aerodrome-wallet-rpc.mjs && node scripts/test-dual-lane-wallet-rpc.mjs && node scripts/test-local-wallet-routing.mjs",
        "skygrid:verify": "node scripts/verify-skygrid-routes.mjs",
        "skygrid:test:routing": "node scripts/test-skygrid-routing-success.mjs",
        "intake:policy-test": "node --test tests/skygrid-intake-policy-core.test.mjs",
        "capacity:lease-test": "node --test tests/skygrid-capacity-lease.test.mjs",
        "capacity:lease-verify": "npm run pnpk:validate && npm run capacity:lease-test",
        "revenue:ledger:test": "node --test tests/skygrid-revenue-ledger.test.mjs",
        "aura:selection:watch": "node scripts/aura-core-ai-selection-watch.mjs",
        "mcp:check": "node scripts/check-mcp-sdk.mjs",
        "emergency:gate": "node scripts/skygrid-emergency-gate.mjs",
        "local:worker:start": "node scripts/skygrid-local-worker-start.mjs --approve-owner-test",
        "eth:collection:draft": "node scripts/skygrid-ethereum-collection-draft.mjs",
        "local:ethereum:proof": "pnpm run local:worker:start && pnpm run eth:collection:draft",
        "local:worker:proof": "node scripts/skygrid-local-worker-start.mjs",
        "local:worker:fallback": "node scripts/skygrid-local-worker-start.mjs --approve-owner-test --fallback",
        "local:owner:selftest": "node scripts/skygrid-owner-self-test-execute.mjs",
        "smoke:ai-gateway": "node --env-file=.env.local ./scripts/ai-gateway-smoke.mjs",
        "local:runtime": "node --import ./scripts/skygrid-ci-auth-bootstrap.mjs scripts/skygrid-local-runtime-server.mjs",
        "agentkit:basepay:smoke": "node --env-file=.env.local scripts/agentkit-basepay-smoke.mjs",
        "route:probe": "node scripts/skygrid-route-option-probe.mjs",
        "route:probe:primary": "node scripts/skygrid-route-option-probe.mjs --scenario=primary",
        "route:probe:local": "node scripts/skygrid-route-option-probe.mjs --scenario=local",
        "route:probe:queue": "node scripts/skygrid-route-option-probe.mjs --scenario=queue",
        "route:probe:proof": "pnpm run route:probe:primary && pnpm run route:probe:local && pnpm run route:probe:queue",
        "pilot:score": "node scripts/score-skygrid-controlled-pilot.mjs",
        "security:ioc-check": "node scripts/check-iocs.mjs",
        "skygrid:verify:public": "node scripts/verify-skygrid-public.mjs",
        "postman:mock": "node scripts/postman-create-skygrid-mock.mjs",
        "postman:mock:test": "node scripts/test-postman-superhighway-contract.mjs",
        "opensea:preflight-test": "node --test tests/skygrid-opensea-preflight.test.mjs",
        "etherscan:read-test": "node --test tests/skygrid-etherscan-read.test.mjs",
        "route:matrix:test": "node --test tests/skygrid-global-route-matrix.test.mjs tests/skygrid-global-route-matrix-api.test.mjs"
    },
    "dependencies": {
        "@coinbase/agentkit": "^0.10.4",
        "@modelcontextprotocol/sdk": "latest",
        "@vercel/sandbox": "^2.2.1",
        "ai": "^6.0.208",
        "express": "^5.2.1",
        "openai": "^6.47.0",
        "xmcp": "^0.6.13",
        "zod": "^3.25.76"
    },
    "bin": {
        "ng": "tools/ng/index.mjs",
        "xmcp": "tools/xmcp/index.mjs"
    }
}
