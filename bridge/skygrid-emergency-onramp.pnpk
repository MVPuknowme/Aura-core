{
  "pnpk_version": "1.3.0",
  "pnpk_profile": "runtime-policy",
  "service": "SKYGRID Emergency Data On-Ramp",
  "operator": "MVPuknowme",
  "mode": "controlled_pilot",
  "sentinel": "fail_closed",
  "runtime_policy": {
    "payment_execution": false,
    "device_activation": false,
    "production_failover": false,
    "private_data_movement": false
  },
  "routes": {
    "health": "/health.json",
    "api_health": "/api/health",
    "highway_status": "/api/highway/status",
    "highway_flasks": "/api/highway/flasks",
    "highway_postman": "/api/highway/postman",
    "pay_quote": "/api/pay/quote?amount=25",
    "stripe_device_link": "/api/stripe/device-link",
    "dispatch": "/dispatch",
    "scenarios": "/scenarios",
    "rates": "/rates",
    "base": "/base",
    "pay": "/pay",
    "capacity_lease": "/lease",
    "capacity_preflight": "/api/node-lease/preflight",
    "capacity_agreement": "/api/node-lease/agreements"
  },
  "platforms": {
    "cloudflare_worker": {
      "enabled": true,
      "primary": true,
      "domain": "https://api.skygrid-protocol.net"
    },
    "aws_lambda": {
      "enabled": true,
      "role": "emergency_validation_runtime",
      "activation_scope": "emergency_routes_only",
      "execution_mode": "controlled_pilot_advisory"
    },
    "web3": {
      "enabled": true,
      "role": "provisional_lease_quote_runtime",
      "chain": "ethereum",
      "execution_mode": "quote_only_no_wallet_signing"
    },
    "stripe": {
      "enabled": true,
      "mode": "test_or_disabled",
      "live_mode_allowed": false
    },
    "postman": {
      "enabled": true,
      "guardrail_tests_required": true,
      "target_route": "/api/highway/postman"
    },
    "ethernet": {
      "enabled": true,
      "role": "preferred_local_transport_candidate",
      "verification_mode": "interface_presence_and_address_only",
      "os_network_switching_allowed": false,
      "interface_reconfiguration_allowed": false
    },
    "allbridge_core": {
      "enabled": true,
      "role": "cross_network_bridge_preflight_candidate",
      "verification_mode": "configuration_and_optional_health_only",
      "status_url_env": "ALLBRIDGE_CORE_STATUS_URL",
      "bridge_execution_allowed": false,
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false
    },
    "solana_playground": {
      "enabled": true,
      "role": "post_build_validation_target",
      "cluster": "devnet",
      "execution_mode": "artifact_and_policy_validation_only",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "program_deployment_allowed": false
    }
  },
  "provisioning_router": {
    "enabled": true,
    "controller": "aura_core_ai_switch",
    "selection_mode": "route_need_and_end_user_lease_value_fail_closed",
    "runtime_targets": {
      "postman": "/api/highway/postman",
      "lambda": "aws_lambda.emergency_validation_runtime",
      "web3": "ethereum.provisional_lease_quote_runtime",
      "allbridge_core": "allbridge_core.preflight_candidate",
      "solana_playground": "solana_playground.post_build_validation_target"
    },
    "route_rules": [
      {
        "when": "route_type=emergency",
        "select": "lambda",
        "reason": "emergency data requires validation runtime"
      },
      {
        "when": "route_type=provisional_lease OR lease_need!=none",
        "select": "web3_quote_pending_end_user",
        "reason": "lease quote is offered to the end user; final planning state is based on the end user's offered lease value decision"
      },
      {
        "when": "end_user_decision=accept AND offered_lease_value_eth>0",
        "select": "web3_quote_accepted_no_execution",
        "reason": "end user accepted the offered lease value; controlled pilot still permits quote/planning only"
      },
      {
        "when": "end_user_decision=decline",
        "select": "postman",
        "reason": "end user declined the offered lease value; remain advisory through Postman"
      },
      {
        "when": "route_type=diagnostic",
        "select": "postman",
        "reason": "diagnostic routes run through Postman validation"
      },
      {
        "when": "route_type=bridge_preflight AND requested_transport=ethernet",
        "select": "allbridge_core_preflight",
        "reason": "Allbridge Core may be evaluated only after the Ethernet and bridge policy pre-runs pass"
      },
      {
        "when": "route_type=solana_playground",
        "select": "solana_playground_preflight",
        "reason": "Solana Playground receives build-artifact and policy verification only"
      }
    ],
    "end_user_offer_gate": {
      "enabled": true,
      "required_for": "provisional_lease",
      "decision_field": "end_user_decision",
      "value_field": "offered_lease_value_eth",
      "accepted_values": [
        "accept",
        "decline",
        "pending"
      ],
      "pending_behavior": "quote_only_wait_for_end_user",
      "decline_behavior": "remain_postman_advisory",
      "accept_behavior": "web3_quote_accepted_no_execution"
    },
    "ethereum_gas_supply": {
      "mode": "quote_only",
      "chain": "ethereum",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "gas_fields": [
        "gas_units",
        "max_fee_gwei",
        "max_fee_eth",
        "offered_lease_value_eth"
      ]
    },
    "auto_drill_space": {
      "enabled": true,
      "mode": "quote_and_reserve_only",
      "harvest_execution_allowed": false,
      "production_failover_allowed": false,
      "description": "Auto-Drill receives route and compute-space planning envelopes only during controlled pilot, after the end user's lease-value decision is recorded."
    },
    "capacity_lease_delivery": {
      "enabled": true,
      "packet_version": "1.1.0",
      "agreement_version": "skygrid-capacity-lease-pilot-v1",
      "website_route": "/lease",
      "preflight_route": "/api/node-lease/preflight",
      "agreement_route": "/api/node-lease/agreements",
      "inventory_sources": [
        "browser_preflight",
        "signed_local_agent"
      ],
      "resource_classes": [
        "storage",
        "compute",
        "gpu",
        "diagnostic"
      ],
      "execution_authority": "none",
      "owner_agreement_persistence": "cloudflare_d1",
      "activation_grant_required": true,
      "partition_policy": {
        "unallocated_space_only": true,
        "automatic_shrink_allowed": false,
        "delete_existing_partition_allowed": false,
        "system_or_boot_disk_allowed": false,
        "storage_layout_hash_match_required": true,
        "rollback_proof_required": true
      },
      "agreement_states": [
        "offered",
        "owner_accepted_pending_operator",
        "approved_pending_activation",
        "active",
        "released",
        "rejected",
        "expired"
      ]
    },
    "guardrails": [
      "Advisory controlled pilot only",
      "End-user lease-value decision required for provisional lease planning",
      "No payment execution",
      "No wallet signing",
      "No transaction broadcast",
      "No device activation",
      "No production failover",
      "No private data movement",
      "No OS-level Ethernet switching or interface reconfiguration",
      "No Allbridge transaction execution",
      "No Solana program deployment"
    ]
  },
  "post_build_pipeline": {
    "enabled": true,
    "trigger": "post_build",
    "profile": "solana_playground_preflight",
    "execution_model": "allowlisted_local_scripts_only",
    "arbitrary_commands_allowed": false,
    "fail_closed": true,
    "receipt_path": "artifacts/pnpk/proofs/postbuild-latest.json",
    "steps": [
      {
        "id": "pnpk_validate",
        "required": true
      },
      {
        "id": "switch_prerun_verify",
        "required": true
      },
      {
        "id": "autodrill_simulation",
        "required": true
      },
      {
        "id": "capacity_lease_contract",
        "required": true
      },
      {
        "id": "solana_playground_preflight",
        "required": true
      }
    ]
  },
  "aura_core_ai_switch": {
    "enabled": true,
    "purpose": "select approved SKYGRID runtimes and choose Postman/Lambda/Web3 planning paths from PNPK-approved candidates, with provisional lease planning gated by end-user offered lease value decision",
    "allowed_actions": [
      "read_pnpk_ramp_registry",
      "check_ramp_health",
      "select_active_ramp",
      "select_planning_runtime",
      "create_gas_quote_envelope",
      "create_auto_drill_space_envelope",
      "create_capacity_lease_offer",
      "record_capacity_owner_agreement",
      "create_capacity_agreement_receipt",
      "verify_ethernet_candidate",
      "verify_allbridge_core_candidate",
      "create_switch_prerun_receipt",
      "create_solana_playground_preflight_receipt",
      "record_end_user_lease_value_decision",
      "report_active_ramp"
    ],
    "blocked_actions": [
      "payment_execution",
      "wallet_signing",
      "transaction_broadcast",
      "device_activation",
      "production_failover",
      "private_data_movement",
      "disk_partition_without_activation_grant",
      "system_or_boot_disk_partition",
      "existing_partition_delete_or_shrink",
      "gpu_enrollment_without_activation_grant",
      "os_level_network_switching",
      "ethernet_interface_reconfiguration",
      "allbridge_transaction_execution",
      "solana_program_deployment",
      "rf_control",
      "nuisance_signal_output"
    ],
    "selected_ramp_ref": "platforms.cloudflare_worker",
    "decision_inputs": [
      "health_http_status",
      "health_ok",
      "health_mode",
      "health_sentinel",
      "route_availability",
      "route_type",
      "lease_need",
      "offered_lease_value_eth",
      "end_user_decision",
      "ethereum_gas_quote",
      "auto_drill_space_request",
      "capacity_inventory",
      "selected_capacity_option",
      "capacity_owner_agreement",
      "ethernet_interface_presence",
      "allbridge_core_status",
      "switch_prerun_receipt",
      "solana_build_artifact_hash"
    ],
    "decision_output": {
      "active_ramp": null,
      "planning_runtime": null,
      "end_user_gate": null,
      "reason": "pending_health_route_and_end_user_check"
    },
    "pre_run_verification": {
      "enabled": true,
      "fail_closed": true,
      "selection_rule": "a candidate is selectable only when its required pre-runs pass",
      "checks": {
        "ethernet": {
          "required_for": [
            "allbridge_core"
          ],
          "mode": "presence_and_address_only",
          "os_switching_allowed": false,
          "interface_reconfiguration_allowed": false
        },
        "allbridge_core": {
          "required_for": [
            "bridge_preflight"
          ],
          "mode": "configuration_and_optional_health_only",
          "external_status_optional_until_configured": true,
          "bridge_execution_allowed": false
        }
      }
    }
  },
  "triggers": {
    "emergency_ramp_health_check": {
      "enabled": true,
      "method": "GET",
      "route": "/health.json",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "api_ramp_health_check": {
      "enabled": true,
      "method": "GET",
      "route": "/api/health",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "postman_runtime_check": {
      "enabled": true,
      "method": "GET",
      "route": "/api/highway/postman",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "stripe_device_link_guardrail": {
      "enabled": true,
      "method": "POST",
      "route": "/api/stripe/device-link",
      "must_block": [
        "execute=true",
        "activate_device=true",
        "mode=live"
      ]
    },
    "capacity_lease_preflight": {
      "enabled": true,
      "method": "POST",
      "route": "/api/node-lease/preflight",
      "execution_authority": "none",
      "expected_sentinel": "fail_closed"
    },
    "capacity_lease_agreement": {
      "enabled": true,
      "method": "POST",
      "route": "/api/node-lease/agreements",
      "result": "owner_accepted_pending_operator",
      "activation_grant_required": true
    }
  },
  "partitions": {
    "emergency": {
      "allowed_ramps": [
        "cloudflare_worker",
        "aws_lambda"
      ],
      "allowed_nodes": [
        "validator",
        "field",
        "edge"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed"
    },
    "diagnostic": {
      "allowed_ramps": [
        "postman"
      ],
      "allowed_nodes": [
        "validator",
        "home",
        "edge"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed"
    },
    "web3_quote": {
      "allowed_ramps": [
        "arbitrum",
        "scroll",
        "base"
      ],
      "allowed_nodes": [
        "validator"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "payment_execution_allowed": false
    },
    "autodrill": {
      "allowed_ramps": [
        "aws_lambda",
        "postman"
      ],
      "allowed_nodes": [
        "edge",
        "field",
        "validator"
      ],
      "mode": "quote_and_reserve_only",
      "sentinel": "fail_closed",
      "production_failover_allowed": false,
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "payment_execution_allowed": false
    },
    "capacity_lease": {
      "allowed_ramps": [
        "cloudflare_worker"
      ],
      "allowed_nodes": [
        "home",
        "edge",
        "field",
        "validator"
      ],
      "mode": "preflight_and_agreement_only",
      "sentinel": "fail_closed",
      "execution_authority": "none",
      "activation_grant_required": true,
      "system_or_boot_disk_allowed": false,
      "automatic_volume_shrink_allowed": false,
      "partition_delete_allowed": false
    },
    "bridge_preflight": {
      "allowed_ramps": [
        "allbridge_core"
      ],
      "allowed_transports": [
        "ethernet"
      ],
      "allowed_nodes": [
        "edge",
        "validator"
      ],
      "mode": "preflight_only",
      "sentinel": "fail_closed",
      "bridge_execution_allowed": false,
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false
    },
    "solana_playground": {
      "allowed_ramps": [
        "solana_playground"
      ],
      "allowed_nodes": [
        "validator"
      ],
      "mode": "preflight_only",
      "sentinel": "fail_closed",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "program_deployment_allowed": false
    }
  },
  "dual_approval_gate": {
    "enabled": true,
    "required_approvals": [
      "owner",
      "emergency_operator"
    ],
    "approval_logic": "owner_and_emergency_operator_required",
    "missing_approval_behavior": "fail_closed",
    "applies_to": [
      "emergency",
      "autodrill",
      "system_health",
      "recovery_proof",
      "continuity_log",
      "web3_quote",
      "capacity_lease",
      "bridge_preflight",
      "solana_playground"
    ],
    "trust_statement": "PNPK is the policy traffic layer. SKYGRID routes only when owner and emergency operator approval agree."
  },
  "access_transparency": {
    "enabled": true,
    "mode": "receipt_only_no_interception_authority",
    "instrumented_boundary_only": true,
    "tamper_evident_not_tamper_proof": true,
    "content_capture_default": false,
    "interception_execution_allowed": false,
    "no_auto_acceptance_from_document_label": true,
    "legal_review_required": true,
    "warrant_particularity_required": true,
    "receipt_events": [
      "tamper_detected",
      "access_pre_requested",
      "access_requested",
      "access_approved",
      "access_denied",
      "access_activated",
      "access_modified",
      "access_expired",
      "access_revoked",
      "interception_requested",
      "interception_approved",
      "interception_activated",
      "interception_ended",
      "notification_delayed",
      "subject_notified"
    ],
    "authority_types_receipted": [
      "consent",
      "warrant",
      "court_order",
      "subpoena",
      "emergency_request",
      "operator_maintenance_approval",
      "other_legal_process"
    ],
    "required_authority_fields": [
      "authority_type",
      "issuing_authority",
      "jurisdiction",
      "legal_process_identifier",
      "target_scope",
      "data_categories",
      "service_account_facility_or_place",
      "start_at",
      "expires_at",
      "minimization_or_handling_rule",
      "approver_identity",
      "notification_status",
      "delayed_notice_basis",
      "delayed_notice_expires_or_review_at"
    ],
    "ambiguous_or_overbroad_behavior": "fail_closed_no_access",
    "expired_or_revoked_behavior": "fail_closed_no_access",
    "emergency_request_behavior": "receipt_immediately_require_legal_and_post_access_review",
    "notification_policy": {
      "notify_when_lawfully_permitted": true,
      "delayed_notice_requires_basis": true,
      "delayed_notice_requires_expiration_or_review_at": true
    },
    "receipt_content_policy": {
      "metadata_and_hashes_only": true,
      "call_or_message_content_allowed": false,
      "public_receipts_redacted": true,
      "secrets_or_protected_details_allowed": false
    },
    "grade_outcomes": [
      "verified_current",
      "verified_delayed_notice",
      "incomplete_fail_closed",
      "conflicted_fail_closed",
      "tamper_alert"
    ],
    "limitations": [
      "PNPK observes only participating systems inside configured instrumented trust boundaries",
      "Receipts are tamper-evident records and do not prove that no unobserved access occurred",
      "PNPK does not create interception authority or override a court order, statutory secrecy, or lawful nondisclosure requirement",
      "PNPK cannot compel a government, carrier, platform, or technical operator outside the participating system to disclose access",
      "Call and message content is not captured by default"
    ]
  }
}
