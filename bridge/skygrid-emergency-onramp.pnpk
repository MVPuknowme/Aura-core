{
  "pnpk_version": "1.0.0",
  "service": "SKYGRID Emergency Data On-Ramp",
  "operator": "MVPuknowme",
  "mode": "controlled_pilot",
  "sentinel": "fail_closed",
  "runtime_policy": {
    "payment_execution": false,
    "device_activation": false,
    "production_failover": false,
    "private_data_movement": false
  },
  "routes": {
    "health": "/health.json",
    "api_health": "/api/health",
    "highway_status": "/api/highway/status",
    "highway_flasks": "/api/highway/flasks",
    "highway_postman": "/api/highway/postman",
    "pay_quote": "/api/pay/quote?amount=25",
    "stripe_device_link": "/api/stripe/device-link",
    "dispatch": "/dispatch",
    "scenarios": "/scenarios",
    "rates": "/rates",
    "base": "/base",
    "pay": "/pay",
    "capacity_lease": "/lease",
    "capacity_preflight": "/api/node-lease/preflight",
    "capacity_agreement": "/api/node-lease/agreements"
  },
  "platforms": {
    "cloudflare_worker": {
      "enabled": true,
      "primary": true,
      "domain": "https://api.skygrid-protocol.net"
    },
    "vercel": {
      "enabled": true,
      "fallback": true,
      "runtime": "vercel-static",
      "ramps": {
        "aura_core_primary": {
          "enabled": true,
          "role": "primary_vercel_ramp",
          "domain": "https://aura-core.vercel.app",
          "health_route": "/api/health",
          "static_health_route": "/health.json",
          "postman_route": "/api/highway/postman",
          "status": "candidate_until_health_200"
        },
        "aura_core_t2t5": {
          "enabled": true,
          "role": "secondary_vercel_ramp",
          "domain": "https://aura-core-t2t5.vercel.app",
          "health_route": "/api/health",
          "static_health_route": "/health.json",
          "postman_route": "/api/highway/postman",
          "status": "candidate_until_health_200"
        }
      },
      "active_ramp_policy": {
        "controller": "aura_core_ai_switch",
        "selection_mode": "health_first_fail_closed",
        "default_ramp": "aura_core_primary",
        "fallback_ramp": "aura_core_t2t5",
        "activation_rule": "select the first enabled ramp returning HTTP 200 with ok=true, mode=controlled_pilot, sentinel=fail_closed",
        "no_healthy_ramp_behavior": "fail_closed_no_route_activation"
      }
    },
    "aws_lambda": {
      "enabled": true,
      "role": "emergency_validation_runtime",
      "activation_scope": "emergency_routes_only",
      "execution_mode": "controlled_pilot_advisory"
    },
    "web3": {
      "enabled": true,
      "role": "provisional_lease_quote_runtime",
      "chain": "ethereum",
      "execution_mode": "quote_only_no_wallet_signing"
    },
    "stripe": {
      "enabled": true,
      "mode": "test_or_disabled",
      "live_mode_allowed": false
    },
    "postman": {
      "enabled": true,
      "guardrail_tests_required": true,
      "target_route": "/api/highway/postman"
    }
  },
  "provisioning_router": {
    "enabled": true,
    "controller": "aura_core_ai_switch",
    "selection_mode": "route_need_and_end_user_lease_value_fail_closed",
    "runtime_targets": {
      "postman": "/api/highway/postman",
      "lambda": "aws_lambda.emergency_validation_runtime",
      "web3": "ethereum.provisional_lease_quote_runtime"
    },
    "route_rules": [
      {
        "when": "route_type=emergency",
        "select": "lambda",
        "reason": "emergency data requires validation runtime"
      },
      {
        "when": "route_type=provisional_lease OR lease_need!=none",
        "select": "web3_quote_pending_end_user",
        "reason": "lease quote is offered to the end user; final planning state is based on the end user's offered lease value decision"
      },
      {
        "when": "end_user_decision=accept AND offered_lease_value_eth>0",
        "select": "web3_quote_accepted_no_execution",
        "reason": "end user accepted the offered lease value; controlled pilot still permits quote/planning only"
      },
      {
        "when": "end_user_decision=decline",
        "select": "postman",
        "reason": "end user declined the offered lease value; remain advisory through Postman"
      },
      {
        "when": "route_type=diagnostic",
        "select": "postman",
        "reason": "diagnostic routes run through Postman validation"
      }
    ],
    "end_user_offer_gate": {
      "enabled": true,
      "required_for": "provisional_lease",
      "decision_field": "end_user_decision",
      "value_field": "offered_lease_value_eth",
      "accepted_values": [
        "accept",
        "decline",
        "pending"
      ],
      "pending_behavior": "quote_only_wait_for_end_user",
      "decline_behavior": "remain_postman_advisory",
      "accept_behavior": "web3_quote_accepted_no_execution"
    },
    "ethereum_gas_supply": {
      "mode": "quote_only",
      "chain": "ethereum",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "gas_fields": [
        "gas_units",
        "max_fee_gwei",
        "max_fee_eth",
        "offered_lease_value_eth"
      ]
    },
    "auto_drill_space": {
      "enabled": true,
      "mode": "quote_and_reserve_only",
      "harvest_execution_allowed": false,
      "production_failover_allowed": false,
      "description": "Auto-Drill receives route and compute-space planning envelopes only during controlled pilot, after the end user's lease-value decision is recorded."
    },
    "capacity_lease_delivery": {
      "enabled": true,
      "packet_version": "1.1.0",
      "agreement_version": "skygrid-capacity-lease-pilot-v1",
      "website_route": "/lease",
      "preflight_route": "/api/node-lease/preflight",
      "agreement_route": "/api/node-lease/agreements",
      "inventory_sources": [
        "browser_preflight",
        "signed_local_agent"
      ],
      "resource_classes": [
        "storage",
        "compute",
        "gpu",
        "diagnostic"
      ],
      "execution_authority": "none",
      "owner_agreement_persistence": "cloudflare_d1",
      "activation_grant_required": true,
      "partition_policy": {
        "unallocated_space_only": true,
        "automatic_shrink_allowed": false,
        "delete_existing_partition_allowed": false,
        "system_or_boot_disk_allowed": false,
        "storage_layout_hash_match_required": true,
        "rollback_proof_required": true
      },
      "agreement_states": [
        "offered",
        "owner_accepted_pending_operator",
        "approved_pending_activation",
        "active",
        "released",
        "rejected",
        "expired"
      ]
    },
    "guardrails": [
      "Advisory controlled pilot only",
      "End-user lease-value decision required for provisional lease planning",
      "No payment execution",
      "No wallet signing",
      "No transaction broadcast",
      "No device activation",
      "No production failover",
      "No private data movement"
    ]
  },
  "aura_core_ai_switch": {
    "enabled": true,
    "purpose": "select the active Vercel emergency data on-ramp and choose Postman/Lambda/Web3 planning path from PNPK-approved candidates, with provisional lease planning gated by end-user offered lease value decision",
    "allowed_actions": [
      "read_pnpk_ramp_registry",
      "check_ramp_health",
      "select_active_ramp",
      "select_planning_runtime",
      "create_gas_quote_envelope",
      "create_auto_drill_space_envelope",
      "create_capacity_lease_offer",
      "record_capacity_owner_agreement",
      "create_capacity_agreement_receipt",
      "record_end_user_lease_value_decision",
      "report_active_ramp"
    ],
    "blocked_actions": [
      "payment_execution",
      "wallet_signing",
      "transaction_broadcast",
      "device_activation",
      "production_failover",
      "private_data_movement",
      "disk_partition_without_activation_grant",
      "system_or_boot_disk_partition",
      "existing_partition_delete_or_shrink",
      "gpu_enrollment_without_activation_grant",
      "rf_control",
      "nuisance_signal_output"
    ],
    "selected_ramp_ref": "platforms.vercel.active_ramp_policy",
    "decision_inputs": [
      "health_http_status",
      "health_ok",
      "health_mode",
      "health_sentinel",
      "route_availability",
      "route_type",
      "lease_need",
      "offered_lease_value_eth",
      "end_user_decision",
      "ethereum_gas_quote",
      "auto_drill_space_request",
      "capacity_inventory",
      "selected_capacity_option",
      "capacity_owner_agreement"
    ],
    "decision_output": {
      "active_ramp": null,
      "planning_runtime": null,
      "end_user_gate": null,
      "reason": "pending_health_route_and_end_user_check"
    }
  },
  "triggers": {
    "emergency_ramp_health_check": {
      "enabled": true,
      "method": "GET",
      "route": "/health.json",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "api_ramp_health_check": {
      "enabled": true,
      "method": "GET",
      "route": "/api/health",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "postman_runtime_check": {
      "enabled": true,
      "method": "GET",
      "route": "/api/highway/postman",
      "expected_mode": "controlled_pilot",
      "expected_sentinel": "fail_closed"
    },
    "stripe_device_link_guardrail": {
      "enabled": true,
      "method": "POST",
      "route": "/api/stripe/device-link",
      "must_block": [
        "execute=true",
        "activate_device=true",
        "mode=live"
      ]
    },
    "capacity_lease_preflight": {
      "enabled": true,
      "method": "POST",
      "route": "/api/node-lease/preflight",
      "execution_authority": "none",
      "expected_sentinel": "fail_closed"
    },
    "capacity_lease_agreement": {
      "enabled": true,
      "method": "POST",
      "route": "/api/node-lease/agreements",
      "result": "owner_accepted_pending_operator",
      "activation_grant_required": true
    }
  },
  "partitions": {
    "emergency": {
      "allowed_ramps": [
        "cloudflare_worker",
        "aws_lambda",
        "vercel"
      ],
      "allowed_nodes": [
        "validator",
        "field",
        "edge"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed"
    },
    "diagnostic": {
      "allowed_ramps": [
        "postman",
        "vercel"
      ],
      "allowed_nodes": [
        "validator",
        "home",
        "edge"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed"
    },
    "web3_quote": {
      "allowed_ramps": [
        "arbitrum",
        "scroll",
        "base"
      ],
      "allowed_nodes": [
        "validator"
      ],
      "mode": "controlled_pilot",
      "sentinel": "fail_closed",
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "payment_execution_allowed": false
    },
    "autodrill": {
      "allowed_ramps": [
        "vercel",
        "aws_lambda",
        "postman"
      ],
      "allowed_nodes": [
        "edge",
        "field",
        "validator"
      ],
      "mode": "quote_and_reserve_only",
      "sentinel": "fail_closed",
      "production_failover_allowed": false,
      "wallet_signing_allowed": false,
      "transaction_broadcast_allowed": false,
      "payment_execution_allowed": false
    },
    "capacity_lease": {
      "allowed_ramps": [
        "cloudflare_worker",
        "vercel"
      ],
      "allowed_nodes": [
        "home",
        "edge",
        "field",
        "validator"
      ],
      "mode": "preflight_and_agreement_only",
      "sentinel": "fail_closed",
      "execution_authority": "none",
      "activation_grant_required": true,
      "system_or_boot_disk_allowed": false,
      "automatic_volume_shrink_allowed": false,
      "partition_delete_allowed": false
    }
  },
  "dual_approval_gate": {
    "enabled": true,
    "required_approvals": [
      "owner",
      "emergency_operator"
    ],
    "approval_logic": "owner_and_emergency_operator_required",
    "missing_approval_behavior": "fail_closed",
    "applies_to": [
      "emergency",
      "autodrill",
      "system_health",
      "recovery_proof",
      "continuity_log",
      "web3_quote",
      "capacity_lease"
    ],
    "trust_statement": "PNPK is the policy traffic layer. SKYGRID routes only when owner and emergency operator approval agree."
  }
}
