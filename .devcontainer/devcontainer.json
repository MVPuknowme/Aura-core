{
  "name": "Aura-Core privacy dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "20",
      "pnpmVersion": "10.23.0"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "SKYGRID_PRIVACY_DEFAULT": "private",
    "SKYGRID_SENSITIVE_STDOUT": "disabled",
    "SKYGRID_EXTERNAL_EXPORT": "explicit-only",
    "SKYGRID_EVIDENCE_DIR": "/home/vscode/.skygrid-private"
  },
  "mounts": [
    "source=aura-core-private-evidence,target=/home/vscode/.skygrid-private,type=volume"
  ],
  "postCreateCommand": "sudo mkdir -p /home/vscode/.skygrid-private && sudo chown $(id -u):$(id -g) /home/vscode/.skygrid-private && chmod 700 /home/vscode/.skygrid-private"
}
